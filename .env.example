# Copy to .env.local (never committed). On Vercel, add the same names under
# Settings → Environment Variables (Production and Preview).
# The shared PolyHydra Supabase project → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (secret) key: server only (sign-in lookup, login lock, npm run data:sync). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
